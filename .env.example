# Durable worker
WORKER_POLL_SECONDS=5
WORKER_LEASE_MINUTES=360
YOUTUBE_JOB_MAX_ATTEMPTS=5

# Ordered free-tier transcript providers. Missing keys disable a provider.
YOUTUBE_TRANSCRIPT_PROVIDERS=supadata,scribetube,transcriptapi_io
# For local-only testing, use YOUTUBE_TRANSCRIPT_PROVIDERS=direct. Direct
# YouTube access commonly fails from VPS/datacenter IPs.
SUPADATA_API_KEY=
SUPADATA_MONTHLY_LIMIT=100
SCRIBETUBE_API_KEY=
SCRIBETUBE_MONTHLY_LIMIT=1000
TRANSCRIPTAPI_IO_API_KEY=
TRANSCRIPTAPI_IO_MONTHLY_LIMIT=100
