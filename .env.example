# Copy this file to .env and fill in real values. .env is gitignored.
# DO NOT commit your real .env to version control.

# LLM API Keys (at least one required)
GEMINI_API_KEY=
GROQ_API_KEY=

# Which LLM to use: "deepseek", "groq", or "gemini" (default: deepseek)
LLM_PROVIDER=deepseek

# Optional: Email notification (Gmail SMTP)
GMAIL_USER=
GMAIL_APP_PASSWORD=
RECIPIENT_EMAIL=

# Path to your OPML file (exported from Feedly/Inoreader/etc.)
OPML_PATH=RSS Feeds main.xml

# Directory where SQLite database and logs live
DATA_DIR=./data

# Daily scrape schedule (IST timezone, default 8:00 PM)
SCRAPE_CRON_HOUR=20
SCRAPE_CRON_MINUTE=0

# Scraping window: how far back to look for new articles (hours)
LOOKBACK_HOURS=24

# Summarization limits
MAX_ARTICLE_CHARS=15000
MIN_SUMMARY_CHARS=600
CHUNK_SIZE=4000
CHUNK_OVERLAP=400

# Web UI basic auth (simple username/password)
WEB_USERNAME=admin
WEB_PASSWORD=changeme
